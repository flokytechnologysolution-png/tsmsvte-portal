# ---------------------------------------------------------------------------
# Taraba State Ministry of Secondary, Vocational and Technical Education
# Portal environment file.  Copy to ".env" and edit.  NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public URL of the portal (used in SMS/links and the ownership-transfer email)
PORTAL_URL=http://localhost:3000
# Comma separated list of extra allowed browser origins (empty = same origin)
CORS_ORIGINS=
# Set to 1 when running behind a reverse proxy (Render/Railway/Nginx)
TRUST_PROXY=0

# --- Security ---------------------------------------------------------------
# CHANGE THIS. 64+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=7d
# 1 = only send cookies over HTTPS (set to 1 in production)
COOKIE_SECURE=0

# --- Storage ----------------------------------------------------------------
DB_FILE=./data/portal.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- First owner account (created automatically on first boot) --------------
OWNER_EMAIL=owner@example.gov.ng
OWNER_PASSWORD=ChangeMe!2026
OWNER_NAME=Portal Owner

# --- Internal mail ----------------------------------------------------------
# Domain used for internal portal mail addresses (firstname.lastname@DOMAIN)
MAIL_DOMAIN=tsmsvte.gov.ng

# --- AI assistant (server side only, never sent to the browser) -------------
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=500
AI_HISTORY_MESSAGES=8

# --- SMS --------------------------------------------------------------------
# Termii is the default adapter. Leave the key empty to stay in DRY-RUN mode.
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com/api
# The sender ID Termii has APPROVED for this account. Takes priority over
# SMS_SENDER_ID and over Admin, Site settings. Must match exactly.
TERMII_SENDER_ID=
# Message channel: 'generic' or 'dnd'. Ask Termii support which one reaches
# numbers with Do Not Disturb enabled before sending official emergency alerts.
TERMII_CHANNEL=generic
# Legacy name, used only when TERMII_SENDER_ID above is empty.
SMS_SENDER_ID=TSMSVTE
# 1 = never call the provider API, only log the send (safe for testing).
# Leave at 1 until a real test message to your own number has worked.
SMS_DRY_RUN=1

# --- Optional SMTP bridge (empty = internal portal mail only) ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=