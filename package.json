{
  "name": "taraba-edu-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Official web portal + staff intranet for the Taraba State Ministry of Secondary, Vocational and Technical Education.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "node tools/start-prod.js",
    "dev": "node --watch server.js",
    "seed": "node tools/seed.js",
    "backup": "node tools/backup.js",
    "icons": "node tools/make-icons.js",
    "placeholders": "node tools/make-placeholders.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "openai": "^7.28.0",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@12.11.1": true
